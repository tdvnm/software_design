{
  "name": "tracey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "check": "tsc --noEmit",
    "build": "tsc && sass src/styles/main.scss dist/styles/main.css --no-source-map",
    "start": "python3 server/run.py",
    "db:init": "python3 server/init_db.py",
    "db:import": "python3 server/import_courses.py",
    "test": "npm run build && node --test tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "sass": "^1.101.0",
    "typescript": "^5.0.0"
  }
}
