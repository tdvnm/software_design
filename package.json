{
  "name": "tracey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "check": "tsc --noEmit",
    "build": "tsc && sass src/styles/main.scss dist/styles/main.css --no-source-map",
    "start": "node server/index.js",
    "db:init": "node server/init.js",
    "db:import": "npm run build && node server/import.js",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "sass": "^1.101.0",
    "typescript": "^5.0.0"
  }
}
